# Alpaca paper credentials. Never put real keys in a committed file.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true
ALLOW_LIVE_TRADING=false

# Second paper-order interlock. Leave false during setup and dry evaluation.
PAPER_ORDER_SUBMISSION_ENABLED=false
ALPACA_DATA_FEED=iex

# Traceability
CONFIG_VERSION=mvp_v1_1_decision_baseline_2026_07
PARAMETER_PROFILE=strict_bull_flag_intrabar_v1
DECISION_REGISTER_VERSION=2026-07-17

# Paper entry window
TRADE_WINDOW_START=09:30
TRADE_WINDOW_END=11:30

# Fixed-dollar risk baseline
ACCOUNT_EQUITY_ASSUMPTION=500
MAX_RISK_PER_TRADE=5
MAX_DAILY_LOSS=15
MAX_POSITION_VALUE=125
MAX_OPEN_POSITIONS=1
MAX_ACTIVE_ENTRY_ORDERS=1

# Optional policy limits: blank/null means disabled
MAX_TRADES_PER_DAY=null
MAX_CONSECUTIVE_LOSSES=null
MAX_CONSECUTIVE_LOSSES_PER_SYMBOL_DAY=null
COOLDOWN_AFTER_LOSS_MINUTES=null
DAILY_EQUITY_DRAWDOWN_LIMIT=null

# Scanner values use decimal fractions: 0.10 = 10%, 0.01 = 1%
SCANNER_TOP=20
MIN_PRICE=2
MAX_PRICE=20
MIN_PERCENT_GAIN=0.10
MIN_RVOL=5
MIN_DAY_VOLUME=500000
PREFERRED_FLOAT_MAX=20000000
MAX_SPREAD_PERCENT=0.01
NEAR_HIGH_OF_DAY_PERCENT=0.02

# Testable strategy settings
STRONG_UP_MOVE_MIN_PERCENT=0.03
FLAGPOLE_VOLUME_RATIO_MIN=1.50
PREFERRED_PULLBACK_DEPTH=0.25
PULLBACK_VOLUME_RATIO_MAX=0.70
LARGE_UPPER_WICK_RATIO=0.40
ENTRY_LIMIT_OFFSET_TICKS=2
MAX_ENTRY_CHASE_TICKS=3
ENTRY_ORDER_TIMEOUT_SECONDS=5
MAX_ALLOWED_STOP_DISTANCE=0.20
MAX_EXTENSION_ABOVE_EMA_PERCENT=0.05
MAX_EXTENSION_ABOVE_VWAP_PERCENT=0.05
TARGET_R_MULTIPLE=2.0

# Conservative backtest costs
BACKTEST_ENTRY_SLIPPAGE_BPS=10
BACKTEST_EXIT_SLIPPAGE_BPS=10

LOG_DIR=logs
OUTPUT_DIR=output
